# Canonical origin used in metadata, the sitemap, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://depthyard.com

# Leave the client id unset to build without ads.
# With no client id, every ad slot is omitted and the ad script is not loaded.
# NEXT_PUBLIC_ADSENSE_CLIENT=
# Optional: overrides the "depthyard-below" ad unit set in lib/site.ts.
# NEXT_PUBLIC_ADSENSE_SLOT=
